# OpenAI API-key mode (used by local MCP and as an optional runtime fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_MODEL=gpt-5.5
OPENAI_EXECUTION_MODEL=gpt-5.5
OPENAI_UTILITY_MODEL=gpt-5-mini

# Durable Supabase runtime and remote MCP persistence
SUPABASE_URL=
# Recommended current server credential.
SUPABASE_SECRET_KEY=
# Legacy JWT fallback.
SUPABASE_SERVICE_ROLE_KEY=
SOLODOT_MCP_WORKSPACE_ID=
SOLODOT_MCP_USER_ID=

# Persistent outbound-only runtime
SOLODOT_RUNTIME_ID=
SOLODOT_RUNTIME_CONCURRENCY=8
SOLODOT_MAX_WORKERS=8
SOLODOT_JOB_LEASE_SECONDS=120
SOLODOT_JOB_POLL_MS=2000
SOLODOT_RUNTIME_TOKEN_DIR=/var/lib/solodot/tokens
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
SOLODOT_RUNTIME_ENCRYPTION_KEY=
# Official Codex app-server. Leave CODEX_SUBSCRIPTION_MODEL empty to use the
# subscription account's default Codex model.
CODEX_BINARY=/app/node_modules/.bin/codex
CODEX_SUBSCRIPTION_MODEL=
# Hosted runtimes must keep device mode. Browser mode binds an OAuth callback
# to localhost:1455 and is only for a trusted runtime on the same computer as
# the browser. Enabling browser mode requires both values below.
SOLODOT_CODEX_LOGIN_MODE=device
SOLODOT_RUNTIME_LOCAL_BROWSER_AUTH=false

# Optional remote MCP server. The default container command is the runtime,
# which opens no inbound application port.
SOLODOT_MCP_API_KEYS=
SOLODOT_LOCAL_PRINCIPAL=local-stdio
HOST=127.0.0.1
PORT=8787
